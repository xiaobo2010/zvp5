{
  "name": "@zvms/zvms4-art",
  "packageManager": "pnpm@10.34.5",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaobo2010/zvp5.git"
  },
  "type": "module",
  "scripts": {
    "design:sync": "node scripts/sync-design-css.mjs",
    "predev": "pnpm run design:sync",
    "dev": "vite --port 5173",
    "prebuild": "pnpm run design:sync",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --port 4173",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test \"pnpm preview\" http://localhost:4173/themes/art/ \"pnpm exec cypress run --e2e\"",
    "test:e2e:dev": "start-server-and-test \"pnpm exec vite dev --port 4173 --base=/themes/art/\" http://localhost:4173/themes/art/ \"pnpm exec cypress open --e2e\"",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "commit": "git-cz",
    "generate-pwa-assets": "pwa-assets-generator"
  },

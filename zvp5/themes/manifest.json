{
  "default": "canary",
  "prefix": "/themes/",
  "themes": [
    {
      "id": "canary",
      "label": "Canary",
      "description": "经典 Phi 设计：暗色棱角、青色判定线与现有导航",
      "status": "stable",
      "base": "/",
      "build": {
        "kind": "root"
      }
    },
    {
      "id": "canary-pro",
      "label": "Canary Pro",
      "description": "Pro 工作台：独立左侧导航、液态玻璃卡片与工作台布局",
      "status": "stable",
      "base": "/themes/canary-pro/",
      "source": {
        "kind": "local",
        "path": "zvp5/zvp5-frontend-pro"
      },
      "build": {
        "kind": "vite",
        "install": [
          "pnpm",
          "install",
          "--no-frozen-lockfile"
        ],
        "command": [
          "pnpm",
          "exec",
          "vite",
          "build"
        ]
      }
    },
    {
      "id": "astra-alpha",
      "label": "Astra-Alpha(Only Students)",
      "description": "学生专属 3D 空间：星系工作台、立体卡片与沉浸式模块布局",
      "status": "experimental",
      "base": "/themes/astra-alpha/",
      "source": {
        "kind": "local",
        "path": "zvp5/zvp5-frontend-3d"
      },
      "build": {
        "kind": "vite",
        "install": [
          "pnpm",
          "install",
          "--no-frozen-lockfile"
        ],
        "command": [
          "pnpm",
          "exec",
          "vite",
          "build"
        ]
      },
      "audience": "students"
    }
  ]
}

# Required by production builds. Use /api for the canonical same-origin zvp deployment.
# An absolute HTTPS URL ending in /api remains supported for split-origin rollbacks.
VITE_API_BASE=

# Optional second API origin used only for the small JSON GET race.
VITE_API_RACE_BASE=

# Optional high-bandwidth static asset origin. Must be an absolute HTTPS URL
# ending in /. Leave unset (or use /) for same-origin assets.
VITE_STATIC_BASE=

# Public page origin used to keep PWA scope on zvp when the manifest is served
# from a separate static origin. Use / for same-origin deployments.
VITE_PAGE_BASE=

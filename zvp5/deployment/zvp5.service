[Unit]
Description=ZVP5 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/www/zvp5/backend
Environment=PYTHONUNBUFFERED=1
Environment=TNS_ADMIN=/www/zvp5/adb-wallet-zvp5adb2
# AES 主密钥不走部署树：systemd 在启动时把它复制到 $CREDENTIALS_DIRECTORY，
# 服务停即消失。源文件放 /etc/zvp5/ai-key（root:root 0600），由运维迁移，
# 不参与 rsync。
# 凭据 id 从 zvms_ai_key 改成 zvp5_ai_key。两条同时注入：线上旧代码只认 zvms_ai_key，
# 新代码（util/platform_key.py）认 zvp5_ai_key 并回落旧 id，所以换名不用等代码先上线。
# 新代码部署并验证后，删掉 zvms_ai_key 那一行即可收口。
LoadCredential=zvp5_ai_key:/etc/zvp5/ai-key
LoadCredential=zvms_ai_key:/etc/zvp5/ai-key
EnvironmentFile=/etc/zvp5/zvp-secrets.env
ExecStart=/www/zvp5/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8018 --timeout-keep-alive 75
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zvp5

[Install]
WantedBy=multi-user.target
# 过渡期保留旧 unit 名：`systemctl restart zvms4` 仍能命中同一个服务。
# zvms4.service 文件删除后再 enable，别名才会真正建成；运维手册改完之后可去掉。
Alias=zvms4.service

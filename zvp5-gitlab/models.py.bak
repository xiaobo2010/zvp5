def enum_by_name(type_: type[enum.Enum], name_or_val: Any):
    return type_(name_or_val) if type(name_or_val) != str else type_._member_map_[name_or_val]

def enum_validator(*field_names):
    @field_validator(*field_names, mode='before')
    @classmethod
    def validate(cls: type[BaseModel], value, info: ValidationInfo):
        enum_type = cls.__annotations__[info.field_name]
        if type(enum_type) != enum.EnumMeta or not issubclass(enum_type, enum.IntEnum):
            return value
        elif type(value) == int or type(value) == str:
            return enum_by_name(enum_type, value)
        else:
            raise ValueError
    return validate

def flag_validator(*field_names):
    @field_validator(*field_names, mode='before')
    @classmethod
    def validate(cls: type[BaseModel], value, info: ValidationInfo):
        enum_type = cls.__annotations__[info.field_name]
        if type(enum_type) != enum.EnumMeta or not issubclass(enum_type, enum.IntFlag):
            return value
        elif type(value) == int:
            return enum_type(value)
        elif type(value) == list:
            return functools.reduce(operator.or_, map(lambda x: enum_by_name(enum_type, x), value))
        else:
            raise ValueError
    return validate

advertising_info: db.Table = db.RelationTable('_advertising_info', 'schools', 'advertisements')
help_availability_info: db.Table = db.RelationTable('_help_availability_info', 'schools', 'faqs')
user_grouping_info: db.Table = db.RelationTable('_user_grouping_info', 'users', 'groups')
activity_auth_info: db.Table = db.RelationTable('_activity_auth_info', 'activities', 'users')
activity_audit_info: db.Table = db.RelationTable('_activity_audit_info', 'activities', 'users')
activity_member_info: db.Table = db.RelationTable('_activity_member_info', 'activities', 'members')

class School(db.Model):
    __tablename__ = 'schools'

    ## Columns ##

    object_id: db.Mapped[str] = db.mapped_column(db.ObjectId, primary_key=True, default_factory=utils.object_id)
    name: db.Mapped[str] = db.mapped_column()
    type: db.Mapped[SchoolType] = db.mapped_column(db.IntegralEnum(SchoolType))
    xhid: db.Mapped[Optional[int]] = db.mapped_column()
    _std_onc: db.Mapped[float] = db.mapped_column(default=0)
    _std_off: db.Mapped[float] = db.mapped_column(default=0)
    _std_soc: db.Mapped[float] = db.mapped_column(default=0)
    spec_id: db.Mapped[Optional[str]] = db.mapped_column(db.ForeignKey('resources.object_id'))
    local_api: db.Mapped[Optional[str]] = db.mapped_column()
    create_time: db.Mapped[int] = db.mapped_column(default_factory=utils.timestamp)
    update_time: db.Mapped[int] = db.mapped_column(default_factory=utils.timestamp, onupdate=utils.timestamp)

    ## Relationships ##

    shown_ads: db.WriteOnlyMapped[List['Ad']] = db.relationship(secondary=advertising_info, back_populates='schools')
    shown_faqs: db.WriteOnlyMapped[List['Help']] = db.relationship(secondary=help_availability_info, back_populates='schools')

    ## Properties ##

    standard = ActivityTime.model_property('std')

    ## Pydantic Schema ##

    class upload_schema(db.Schema):
        object_id: Optional[str]
        name: str
        type: SchoolType
        xhid: Optional[int]
        standard: ActivityTime
        spec_id: Optional[str]
        local_api: Optional[str]

        _cast_flag = flag_validator('type')

    class schema(db.Schema):
        object: str
        name: str
        type: SchoolType
        xhid: Optional[int]
        standard: ActivityTime
        spec_id: Optional[str]
        local_api: Optional[str]
        create_time: int
        update_time: int

class TimeConversion(db.Model):
    __tablename__ = 'conversion_rules'

class ActivityTemplate(db.Model):
    __tablename__ = 'templates'

    ## Columns ##

    object_id: db.Mapped[str] = db.mapped_column(db.String(24), primary_key=True)
    name: db.Mapped[str] = db.mapped_column()
    description: db.Mapped[str] = db.mapped_column(default='')
    school_id: db.Mapped[Optional[str]] = db.mapped_column(db.String(24), db.ForeignKey('schools.object_id'))
    allowed_modes: db.Mapped[ActivityMode] = db.mapped_column(default=ActivityMode.ALL)
    permission: db.Mapped[UserRole] = db.mapped_column(default=~UserRole.SECRETARY)
    _max_onc: db.Mapped[float] = db.mapped_column()
    _max_off: db.Mapped[float] = db.mapped_column()
    _max_soc: db.Mapped[float] = db.mapped_column()
    # attachments: db.Mapped[AttachmentType] = db.mapped_column(default=AttachmentType.NONE)
    create_time: db.Mapped[int] = db.mapped_column(default_factory=utils.timestamp)
    update_time: db.Mapped[int] = db.mapped_column(default_factory=utils.timestamp, onupdate=utils.timestamp)

    ## Properties ##

    max_time = ActivityTime.model_property('max')


class Activity(db.Model):
    __tablename__ = 'activities'

    ## Columns ##

    object_id: db.Mapped[str] = db.mapped_column(db.ObjectId, primary_key=True, default_factory=utils.object_id)
    name: db.Mapped[str] = db.mapped_column()
    description: db.Mapped[str] = db.mapped_column(default='')
    template_id: db.Mapped[str] = db.mapped_column(db.String(24), db.ForeignKey('templates.object_id'))
    status: db.Mapped[ActivityStatus] = db.mapped_column()
    creator_id: db.Mapped[str] = db.mapped_column(db.String(24), db.ForeignKey('users.object_id'))
    parent_id: db.Mapped[str] = db.mapped_column(db.String(24), db.ForeignKey('activities.object_id'))
    create_time: db.Mapped[int] = db.mapped_column(default_factory=utils.timestamp)
    update_time: db.Mapped[int] = db.mapped_column(default_factory=utils.timestamp, onupdate=utils.timestamp)

    ## Relationships ##

    authors: db.WriteOnlyMapped['User'] = db.relationship(back_populates='authored_activities', secondary=activity_auth_info)
    auditors: db.WriteOnlyMapped['User'] = db.relationship(back_populates='audited_activities', secondary=activity_audit_info)
    members: db.WriteOnlyMapped['ActivityMember'] = db.relationship(back_populates='activities', secondary=activity_member_info)


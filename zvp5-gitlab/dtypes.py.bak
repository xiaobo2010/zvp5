from pydantic import *
from pydantic_core.core_schema import *

import enum
from typing import *
from annotated_types import *

class SchoolType(enum.IntFlag):
    ELEMENTARY = 1
    JUNIOR_HIGH = 2
    SENIOR_HIGH = 4

    @property
    def grade_count(self) -> int:
        retval: int = 0
        if SchoolType.ELEMENTARY in self:
            retval += 6
        if SchoolType.JUNIOR_HIGH in self:
            retval += 3
        if SchoolType.SENIOR_HIGH in self:
            retval += 3
        return retval
    
class ActivityStatus(enum.IntEnum):
    DRAFT = 0
    PENDING = 1
    EFFECTIVE = 2
    REJECTED = 3
    INVALID = 4
    MERGED = 5
    RECYCLED_PENDING = 6
    RECYCLED_EFFECTIVE = 7
    RECYCLED_REJECTED = 8
    RECYCLED_INVALID = 9

class ActivityMode(enum.IntFlag):
    ON_CAMPUS = 1
    OFF_CAMPUS = 2
    SOCIAL_PRACTICE = 4
    ALL = 7

class UserRole(enum.IntFlag):
    SECRETARY = 1
    STUDENT_UNION = 2
    ADMIN = 4
    SYSTEM = 8

class MemberModificationType(enum.IntEnum):
    ADD = 0
    MODIFY = 1
    DELETE = 2

class WorkflowStatus(enum.IntEnum):
    DRAFT = 0
    PENDING = 1
    SUCCESS = 2
    FAILURE = 3

class WorkflowItemType(enum.IntEnum):
    ACTIVITY_CREATE = 0
    ACTIVITY_MODIFY = 1
    MEMBER_MODIFY = 2
    FLOW_RENAME = 3
    FLOW_APPROVE = 4
    FLOW_REJECT = 5
    FLOW_AUTOCLOSE = 6
    FLOW_CLOSE = 7

class ActivityTime(BaseModel):
    on_campus: Annotated[float, Gt(0)]
    off_campus: Annotated[float, Gt(0)]
    social_practice: Annotated[float, Gt(0)]

    def __eq__(self, other: Self) -> bool:
        return self.model_dump() == other.model_dump()

    class model_property:
        __name__: str

        def __init__(self, name: Optional[str]):
            self.__name__ = name

        def __get__(self, instance, _):
            if instance is None:
                return self
            return ActivityTime(
                on_campus=getattr(instance, f'_{self.__name__}_onc', 0.0),
                off_campus=getattr(instance, f'_{self.__name__}_off', 0.0),
                social_practice=getattr(instance, f'_{self.__name__}_soc', 0.0)
            )
        
        def __set__(self, instance, value):
            if type(value) is not ActivityTime:
                if type(value) == dict:
                    value = ActivityTime.model_validate(value)
                else:
                    raise TypeError
            setattr(instance, f'_{self.__name__}_onc', value.on_campus)
            setattr(instance, f'_{self.__name__}_off', value.off_campus)
            setattr(instance, f'_{self.__name__}_soc', value.social_practice)

        def __set_name__(self, name: str):
            if self.__name__ is None:
                self.__name__ = name

class Hash:
    digest: str

    def __init__(self, digest: str):
        self.digest = digest

    def __repr__(self):
        return '<hashed string>'

    def __eq__(self, other):
        if isinstance(other, str):
            import crypto
            return crypto.check_password(self.digest, other)
        elif isinstance(other, Hash):
            return self.digest == other.digest
        return other is self

    def __ne__(self, other):
        return not self.__eq__(other)

class DeviceInfo(pydantic.BaseModel):
    model: str = 'unknown'
    os: str = 'unknown'
    browser: str = 'unknown'

    @staticmethod
    def from_ua(ua: str, additional_hint: Optional[str] = None):
        return DeviceInfo() # STUB FUNCTION

if TYPE_CHECKING:
    from . import models

class SystemUser(pydantic.BaseModel):
    name: Literal['SYSTEM'] = 'SYSTEM'
    role: Literal[UserRole.SYSTEM] = UserRole.SYSTEM

class Token:
    user: 'models.User' | SystemUser
    scope: Literal['persist', 'authr', 'recovery']
    login_type: str

    @property
    def role(self) -> UserRole:
        return self.user.role